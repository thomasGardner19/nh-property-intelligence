[Unit]
Description=NH Property Intelligence refresh
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=nhpi
Group=nhpi
WorkingDirectory=/opt/nh-property-intelligence
ExecStart=/usr/bin/bash /opt/nh-property-intelligence/deployment/run-refresh.sh
Nice=10

[Install]
WantedBy=multi-user.target
